{
  "name": "hamu-master",
  "version": "1.3.0",
  "private": true,
  "description": "Original WebGL arena FPS with authoritative Node.js multiplayer",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/server.js --open-browser",
    "server": "node server/server.js",
    "client": "node server/client.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "data:location": "node scripts/account-data.js location",
    "data:backup": "node scripts/account-data.js backup",
    "data:list": "node scripts/account-data.js list",
    "data:restore": "node scripts/account-data.js restore",
    "data:managed-backup": "node scripts/managed-backup.js",
    "load:test": "node scripts/load-test.js"
  },
  "dependencies": {
    "ws": "8.21.3"
  }
}
